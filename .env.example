# Database Configuration
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/apex_tape_factory"

# Session Security Secret (minimum 32 characters for HMAC SHA-256)
SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-string-for-production"

# Environment Mode
NODE_ENV="development"
PORT=3000
